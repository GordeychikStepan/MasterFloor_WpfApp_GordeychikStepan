<Window x:Class="MasterFloor_WpfApp.Views.AddEditPartnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterFloor_WpfApp.Views"
        mc:Ignorable="d"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Title="AddEditPartnerWindow"
        Height="500" MinHeight="500"
        Width="550" MinWidth="500">
    
    <Grid Margin="0" Background="#FFFFFF">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Source="/Resources/Мастер пол.png"
                Margin="10"/>

        <TextBlock Grid.Column="1"
                   Name="WindowTitle_TextBlock"
                   Text="Добавление/редактирование партнеров"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontSize="20"
                   Margin="10"/>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Vertical" Margin="10">
            <TextBlock Text="Наименование"/>
            <TextBox x:Name="NameText" Margin="0,5"/>

            <TextBlock Text="Тип партнера"/>
            <ComboBox x:Name="TypeCombo" Margin="0,5"/>

            <TextBlock Text="Рейтинг"/>
            <TextBox x:Name="RatingText" Margin="0,5"/>

            <TextBlock Text="Адрес"/>
            <TextBox x:Name="AddressText" Margin="0,5"/>

            <TextBlock Text="ФИО директора"/>
            <TextBox x:Name="CeoText" Margin="0,5"/>

            <TextBlock Text="Телефон"/>
            <TextBox x:Name="PhoneText" Margin="0,5"/>

            <TextBlock Text="Email"/>
            <TextBox x:Name="EmailText" Margin="0,5"/>
        </StackPanel>


        <!--<TextBlock x:Name="ErrorText" Grid.ColumnSpan="2" Grid.Row="2" Foreground="Red"/>-->


        <StackPanel Margin="10" Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Button Content="Назад" Width="80" Height="30" Margin="5" Click="Cancel_Click"/>
            <Button Content="Сохранить" 
                    Height="30"
                    Background="#67BA80" 
                    Width="80" 
                    Margin="5" 
                    Click="Save_Click" />
            
        </StackPanel>
    </Grid>
</Window>
